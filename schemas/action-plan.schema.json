{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis action plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "actions"],
  "properties": {
    "schema_version": { "const": 1 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "object" }
    }
  }
}
